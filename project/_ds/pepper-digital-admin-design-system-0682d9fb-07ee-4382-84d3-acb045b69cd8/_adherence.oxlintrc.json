        "selector": "JSXOpeningElement[name.name='SummaryStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|amount|delta|trend|style|key|ref|className|style|children)$/]",
        "message": "<SummaryStat> doesn't accept that prop. Declared props: label, count, amount, delta, trend, style."
