{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/admin/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:nanumsquare))/i]",
        "message": "Font not provided by the design system. Available: nanumsquare."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|children|confirmLabel|onConfirm|cancelLabel|onCancel|inline|style|key|ref|className|style|children)$/]",
        "message": "<AlertModal> doesn't accept that prop. Declared props: open, children, confirmLabel, onConfirm, cancelLabel, onCancel, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:menu|active|onNavigate|userName|userPosition|lastLogin|shortcuts|history|onLogout|fixed|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: menu, active, onNavigate, userName, userPosition, lastLogin, shortcuts, history, onLogout, fixed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|addon|danger|success-outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'addon' | 'danger' | 'success-outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|sm|icon)$/]",
        "message": "<Button> size must be one of 'md' | 'lg' | 'sm' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|disabled|inline|name|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, disabled, inline, name, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|height|rowHeight|headerHeight|selectable|onRowClick|style|key|ref|className|style|children)$/]",
        "message": "<DataGrid> doesn't accept that prop. Declared props: columns, rows, height, rowHeight, headerHeight, selectable, onRowClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|width|rangeStart|rangeEnd|onChange|key|ref|className|style|children)$/]",
        "message": "<DateInput> doesn't accept that prop. Declared props: value, defaultValue, placeholder, width, rangeStart, rangeEnd, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Datepicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|rangeStart|rangeEnd|today|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<Datepicker> doesn't accept that prop. Declared props: value, rangeStart, rangeEnd, today, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateRange'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|end|defaultStart|defaultEnd|width|onChange|key|ref|className|style|children)$/]",
        "message": "<DateRange> doesn't accept that prop. Declared props: start, end, defaultStart, defaultEnd, width, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|columns|labelWidth|valueWidth|variant|style|key|ref|className|style|children)$/]",
        "message": "<FieldTable> doesn't accept that prop. Declared props: rows, columns, labelWidth, valueWidth, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldTable'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:borderless|bordered)$/]",
        "message": "<FieldTable> variant must be one of 'borderless' | 'bordered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:calendar|search|close|refresh|edit|fullscreen|lineChart|barChart|pieChart|list|caretUp|caretDown|caretDownSquare)$/]",
        "message": "<Icon> name must be one of 'calendar' | 'search' | 'close' | 'refresh' | 'edit' | 'fullscreen' | 'lineChart' | 'barChart' | 'pieChart' | 'list' | 'caretUp' | 'caretDown' | 'caretDownSquare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|readOnly|disabled|invalid|clearable|align|width|onChange|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, defaultValue, placeholder, readOnly, disabled, invalid, clearable, align, width, onChange, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<Input> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InputGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|addon|onAddonClick|width|inputProps|style|key|ref|className|style|children)$/]",
        "message": "<InputGroup> doesn't accept that prop. Declared props: icon, addon, onAddonClick, width, inputProps, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lnb'] > JSXAttribute > JSXIdentifier[name!=/^(?:tree|tabs|activeId|onSelect|open|defaultOpen|onToggleOpen|height|style|key|ref|className|style|children)$/]",
        "message": "<Lnb> doesn't accept that prop. Declared props: tree, tabs, activeId, onSelect, open, defaultOpen, onToggleOpen, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loading'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|fixed|style|key|ref|className|style|children)$/]",
        "message": "<Loading> doesn't accept that prop. Declared props: open, fixed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|width|inline|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, footer, onClose, width, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|titleSize|meta|actions|padding|fill|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, titleSize, meta, actions, padding, fill, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='titleSize'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Panel> titleSize must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pills'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|defaultValue|size|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Pills> doesn't accept that prop. Declared props: items, value, defaultValue, size, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pills'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Pills> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|disabled|inline|name|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, checked, defaultChecked, disabled, inline, name, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|actions|detail|defaultExpanded|detailLabel|style|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: children, actions, detail, defaultExpanded, detailLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|defaultValue|disabled|width|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, defaultValue, disabled, width, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|style|key|ref|className|style|children)$/]",
        "message": "<Separator> doesn't accept that prop. Declared props: type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Separator'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:hyphen|bar)$/]",
        "message": "<Separator> type must be one of 'hyphen' | 'bar'."
