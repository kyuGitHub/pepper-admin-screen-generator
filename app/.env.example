# Supabase 연결 (Vercel에는 Settings → Environment Variables에 같은 이름으로 등록)
# 둘 다 비어 있으면 로그인 없이 샘플 화면만 보여주는 데모 모드로 동작합니다.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# AI 화면 생성 (Vercel 환경변수에도 같은 이름으로 등록, VITE_ 접두사 없음 — 브라우저로 나가지 않음)
# Anthropic Console(console.anthropic.com) → API Keys 에서 발급. 비어 있으면 [AI로 화면 만들기]가 503을 돌려줍니다.
ANTHROPIC_API_KEY=
# 사용자별 24시간 생성 한도 (기본 30)
AI_DAILY_LIMIT=30
# 1 이면 Claude를 부르지 않고 모의 결과를 돌려줍니다 (로컬 UI 확인용)
AI_MOCK=
